{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "packages/*/dist/**", "apps/*/dist/**", "apps/*/.next/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "AI_PROVIDER",
    "FABLE_API_KEY",
    "FABLE_MODEL",
    "FABLE_BASE_URL",
    "AUTH_SECRET",
    "NEXT_PUBLIC_API_URL"
  ],
  "globalDependencies": [".env*"]
}