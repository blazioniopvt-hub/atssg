{
  "name": "@skillsync/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate --schema=../../database/prisma/schema.prisma",
    "build": "prisma generate --schema=../../database/prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest \"src/__tests__/(critical-path|role-gap|resume-intelligence|evidence-confidence|learning-intelligence|project-intelligence|career-readiness-simulation|career-coach|organization-intelligence|opportunity-placement|observability-audit|integrations-webhooks|security-hardening|entitlements-production).test.ts\" --passWithNoTests --forceExit",
    "test:all": "jest --passWithNoTests",
    "test:integration": "jest src/__tests__/*.integration.test.ts --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=../../database/prisma/schema.prisma",
    "db:push": "node -r dotenv/config ../../node_modules/prisma/build/index.js db push --schema=../../database/prisma/schema.prisma dotenv_config_path=../../.env",
    "db:migrate": "node -r dotenv/config ../../node_modules/prisma/build/index.js migrate dev --schema=../../database/prisma/schema.prisma dotenv_config_path=../../.env",
    "db:migrate:deploy": "node -r dotenv/config ../../node_modules/prisma/build/index.js migrate deploy --schema=../../database/prisma/schema.prisma dotenv_config_path=../../.env",
    "db:studio": "node -r dotenv/config ../../node_modules/prisma/build/index.js studio --schema=../../database/prisma/schema.prisma dotenv_config_path=../../.env",
    "db:seed": "tsx ../../database/prisma/seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/client": "^5.9.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.1",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.8",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdf-text": "^0.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.9.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
