# ==========================================
# SkillSync Environment Configuration Template
# Copy this file to .env at project root
# ==========================================

# ------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------
# Standard PostgreSQL connection URL (Supabase, Neon, CockroachDB, AWS RDS, or local Postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillsync?schema=public"

# ------------------------------------------
# 3. AUTHENTICATION & SECURITY (REQUIRED)
# ------------------------------------------
# Secret key used for signing JWT session tokens. Minimum 32 characters.
# Production: Generate with `openssl rand -base64 32`
AUTH_SECRET="dev-secret-change-in-production-min-32-chars"
# Optional alias for AUTH_SECRET
JWT_SECRET=""
SESSION_COOKIE_NAME="skillsync_session"
SESSION_COOKIE_MAX_AGE=604800

# Webhook signature secret for inbound third-party HMAC verification
WEBHOOK_SECRET="dev-webhook-secret-change-in-production-min-32-chars"

# ------------------------------------------
# 4. AI SERVICE CONFIGURATION (REQUIRED FOR AI EXTRACTION & COACHING)
# ------------------------------------------
# Provider selection: 'fable' | 'openai' | 'anthropic' | 'local' | 'custom'
# Active provider choice (defaults to fable if FABLE_API_KEY is present)
AI_PROVIDER=fable

# Active AI Provider: Fable 5.1 (Primary Grounded Model)
FABLE_API_KEY=
FABLE_MODEL=fable-5.1
FABLE_BASE_URL=https://api.fable.ai/v1

# Alternative: OpenAI Configuration
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Alternative: Anthropic Configuration
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-3-5-haiku-20241022

# Alternative: Local / Ollama Configuration
# AI_PROVIDER=local
# AI_MODEL=llama3.1:8b
# AI_BASE_URL=http://localhost:11434/v1

AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=30000

# ------------------------------------------
# 5. FILE STORAGE CONFIGURATION (OPTIONAL / FEATURE-SPECIFIC)
# ------------------------------------------
# Provider selection: 'local' | 's3' | 'r2' | 'custom'
# If unset, defaults to 'local'
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:4000

# AWS S3 / Cloudflare R2 Configuration (Used if STORAGE_PROVIDER=s3 or r2)
# STORAGE_S3_BUCKET=skillsync-uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=your-access-key-id
# STORAGE_S3_SECRET_ACCESS_KEY=your-secret-access-key
# STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_BASE_URL=https://cdn.skillsync.com
# STORAGE_S3_FORCE_PATH_STYLE=false